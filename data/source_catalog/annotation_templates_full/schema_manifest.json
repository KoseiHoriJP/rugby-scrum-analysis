  "relationships": [
    "Every event_id references events.csv; multiple reset attempts may share episode_id.",
    "rule_assessments.law_clause references the clause coverage catalog; informational/permission/context clauses need observations rather than forced offence assessments.",
    "observations.observation_type uses observation_field_registry.json, generated from the full rule coverage.",
    "restarts.restart_table_row_id references law19_full restart rows; reset_reason_clause independently references 19.34 conditions.",
    "A decision and its referee-stated reason do not automatically populate the independent rule assessment or physical-cause labels.",
    "Official media associations are reference metadata, not player-identity, intent, view or infringement ground truth.",
    "All recordings and derived examples of one match require a common match_group for splitting; source hashes alone cannot identify alternate recordings.",
    "evidence_ids and supporting_observation_ids reference observations in the same event; physical attempt_end_s and explanation_end_s are retained independently, with clip_end_s covering both."
  ],
  "unknowns": "Blank is unannotated. unknown/unobservable are explicit states, never converted to false or not_satisfied.",
  "timebase": "Seconds in the original source video, not scoreboard time; legal scrum start under 19.16 is ball_feed_s.",
  "media_review": {
    "video_contents_reviewed": false,
    "diagram_pixels_reviewed": false
  },
  "implementation_note": "Runtime v2 supports offline seven-table review, validation, lossless JSON resume and CSV export. Conservative fact checks are draft suggestions requiring review; neither tracking nor a referee decision automatically establishes an infringement.",
  "evidence_type_definitions": {
    "video": "Timecoded match video with the relevant body, ball or event visible.",
    "multi_angle_video": "Synchronized additional views supporting contact, causal or depth assessment.",
    "referee_audio": "Audible referee words or whistle with a time reference; ASR output requires review.",
    "referee_signal": "Visible referee mark, arm signal or indication, independently transcribed.",
    "referee_explanation": "An attributable referee explanation; keep it separate from an annotator hypothesis.",
    "preceding_play_video": "Video before the scrum establishing restart cause and prior possession or movement.",
    "match_metadata": "Match, competition, date, team size or competition-level facts from identified sources.",
    "roster": "Reviewed roster or substitution evidence linking player identity and role; shirt number alone is insufficient.",
    "calibrated_pitch_geometry": "Visible calibrated pitch reference resolving location, distance or orientation.",
    "applicable_ruleset": "Identified edition, competition rules, union adoption and trial applicability.",
    "source_diagram": "Source image pixels reviewed separately; the current HTML only provides image references."
  },
